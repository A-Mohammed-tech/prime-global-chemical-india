# Contact form endpoint (e.g. a Formspree form URL: https://formspree.io/f/xxxxxxx).
# Leave empty until the company has a verified inbox. The form will then tell visitors it is not connected.
VITE_FORM_ENDPOINT=

# Set to "false" before launch to hide the "Draft / Proposed / Confirmed" content tags.
VITE_SHOW_DRAFT_TAGS=true
